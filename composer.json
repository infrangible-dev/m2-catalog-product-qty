{
    "name": "infrangible/m2-catalog-product-qty",
    "description": "Shows the product page price as the total for the chosen quantity, with an optional unit price and a per-item hint next to the quantity field.",
    "type": "magento2-module",
    "version": "1.2.5",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Pricing",
        "Catalog",
        "total price for the chosen quantity",
        "unit price display",
        "price times quantity on the product page"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-qty",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductQty\\": "src"
        }
    }
}
